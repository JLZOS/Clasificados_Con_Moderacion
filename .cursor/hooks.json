{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .claude/hooks/guard.mjs --cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .claude/hooks/guard.mjs --cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .claude/hooks/guard.mjs --cursor",
        "matcher": "Write|Edit|StrReplace|Delete|Grep|Glob",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
