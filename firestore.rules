rules_version = '2';

// Autorización real del backend. Debe coincidir con src/domain (listing, moderation, reports).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return signedIn() && request.auth.token.role == 'moderator';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    function validNewListing(d) {
      return d.keys().hasOnly(['title', 'description', 'price', 'category', 'condition',
          'photoUrls', 'sellerId', 'sellerName', 'status', 'reportCount', 'moderationNote',
          'createdAt', 'updatedAt'])
        && d.sellerId == request.auth.uid
        && d.status == 'pending' && d.reportCount == 0 && d.moderationNote == null
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 80
        && d.description is string && d.description.size() >= 20 && d.description.size() <= 2000
        && d.price is int && d.price >= 0 && d.price <= 50000000
        && d.category in ['libros', 'tecnologia', 'ropa', 'muebles', 'deportes', 'servicios', 'otros']
        && d.condition in ['nuevo', 'como_nuevo', 'usado']
        && d.photoUrls is list && d.photoUrls.size() >= 1 && d.photoUrls.size() <= 5
        && d.sellerName is string && d.sellerName.size() <= 80
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    function ownerMarksSold() {
      return isSelf(resource.data.sellerId)
        && resource.data.status == 'approved'
        && request.resource.data.status == 'sold'
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    function reportIncrement(listingId) {
      let next = request.resource.data;
      let reportRef = docPath('reports', listingId + '_' + request.auth.uid);
      return signedIn()
        && !isSelf(resource.data.sellerId)
        && resource.data.status == 'approved'
        && changedKeys().hasOnly(['reportCount', 'status', 'updatedAt'])
        && next.reportCount == resource.data.reportCount + 1
        && next.status == (next.reportCount >= 3 ? 'hidden' : 'approved')
        && next.updatedAt == request.time
        && !exists(reportRef)
        && existsAfter(reportRef);
    }

    function moderatorUpdate() {
      return isModerator()
        && changedKeys().hasOnly(['status', 'reportCount', 'moderationNote', 'updatedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'hidden']
        && request.resource.data.reportCount is int
        && request.resource.data.reportCount >= 0
        && request.resource.data.updatedAt == request.time;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status in ['approved', 'sold']
        || isSelf(resource.data.sellerId)
        || isModerator();
      allow create: if signedIn() && validNewListing(request.resource.data);
      allow update: if ownerMarksSold() || reportIncrement(listingId) || moderatorUpdate();
      allow delete: if isSelf(resource.data.sellerId) || isModerator();
    }

    match /reports/{reportId} {
      // El denunciante puede consultar si ya reportó (lectura dentro de la transacción).
      allow get: if isModerator()
        || (signedIn() && reportId.matches('^[A-Za-z0-9-]+_' + request.auth.uid + '$'));
      allow list: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listingId', 'listingTitle', 'reporterId',
            'reason', 'details', 'status', 'createdAt'])
        && reportId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['fraude', 'prohibido', 'ofensivo', 'spam', 'otro']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.listingTitle is string
        && request.resource.data.createdAt == request.time
        && getAfter(docPath('listings', request.resource.data.listingId)).data.reportCount
          == get(docPath('listings', request.resource.data.listingId)).data.reportCount + 1;
      allow update: if isModerator()
        && changedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if false;
    }

    match /moderationLog/{entryId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.moderatorId == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /users/{uid}/favorites/{listingId} {
      allow read, delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }
  }
}
