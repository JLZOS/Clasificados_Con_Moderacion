{
  "name": "clasificados-con-moderacion",
  "version": "0.1.0",
  "private": true,
  "description": "Compra y venta entre estudiantes con fotos, favoritos, reportes y panel de moderación.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:hooks": "node --test .claude/hooks/guard.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:hooks",
    "emulators": "firebase emulators:start --project demo-clasificados",
    "seed": "tsx scripts/seed.ts",
    "prepare": "husky"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
