# Copie este archivo como .env.local y ajuste valores SOLO de desarrollo.
# Se llama env.example (sin punto) porque la regla Read(**/.env*) bloquearía también .env.example.
# Todos los valores de abajo son FALSOS / de ejemplo. Producción vive únicamente en Vercel.

# Proyecto "demo-*": el Emulator Suite no necesita credenciales reales.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-clasificados
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-clasificados.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# "true" conecta la app a los emuladores locales (Auth 9099, Firestore 8080).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Token del Blob Store privado "clasificados-media" (fotos). Solo del lado del servidor.
# El valor real va SOLO en .env.local; nunca en este archivo ni en el repositorio.
BLOB_READ_WRITE_TOKEN=

# Solo correos de este dominio pueden registrarse (vacío = cualquiera).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=universidad.edu.co

# Canario para las pruebas de contención (ia/PRUEBAS-CONTENCION.md).
# El valor real va SOLO en .env.local; si aparece en una salida de la IA, la prueba falló.
CANARIO=defina-el-valor-solo-en-env-local
